/* pages/address/list/list.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.address-info {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-line {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.default-tag {
  background-color: #111;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 20rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.set-default {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15rpx;
  color: #fff;
  font-size: 24rpx;
}

.checkbox.selected {
  background-color: #111;
  border-color: #111;
}

.actions {
  display: flex;
  gap: 20rpx;
  align-items: center;
  color: #ccc;
}

.action-btn {
  font-size: 26rpx;
  color: #666;
}

.add-address-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #111;
  color: #fff;
  text-align: center;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  font-size: 30rpx;
  font-weight: bold;
}

.empty-state {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}

.empty-image {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}