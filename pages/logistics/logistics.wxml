<!--pages/logistics/logistics.wxml-->
<view class="container">
  <!-- 搜索区域 -->
  <view class="search-section">
    <view class="search-form">
      <view class="form-item">
        <text class="label">快递公司</text>
        <picker bindchange="onCompanyChange" value="{{companyIndex}}" range="{{companies}}" range-key="name">
          <view class="picker">
            {{companies[companyIndex].name}}
            <text class="arrow">></text>
          </view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="label">运单号</text>
        <input class="input" placeholder="请输入运单号" value="{{trackingNo}}" bindinput="onTrackingNoInput" />
      </view>
      
      <view class="search-btn" bindtap="onSearch">
        <text>查询物流</text>
      </view>
    </view>
  </view>

  <!-- 物流信息 -->
  <view class="logistics-info" wx:if="{{logisticsData && !loading}}">
    <view class="info-header">
      <view class="status-info">
        <text class="status">{{logisticsData.status}}</text>
        <text class="company">{{logisticsData.company}}</text>
      </view>
      <view class="tracking-info">
        <text class="tracking-no">运单号：{{logisticsData.trackingNo}}</text>
        <text class="update-time">更新时间：{{logisticsData.updateTime}}</text>
      </view>
    </view>
    
    <!-- 添加查看详情按钮 -->
    <view class="action-buttons">
      <view class="detail-btn" bindtap="onViewDetail">
        <text>查看详情</text>
      </view>
    </view>
    
    <view class="recipient-info" wx:if="{{logisticsData.recipient}}">
      <view class="info-row">
        <text class="label">收件人：</text>
        <text class="value">{{logisticsData.recipient.name}} {{logisticsData.recipient.phone}}</text>
      </view>
      <view class="info-row">
        <text class="label">收货地址：</text>
        <text class="value">{{logisticsData.recipient.address}}</text>
      </view>
    </view>
  </view>

  <!-- 物流轨迹 -->
  <view class="logistics-track" wx:if="{{logisticsData && logisticsData.tracks && !loading}}">
    <view class="track-header">
      <text>物流轨迹</text>
    </view>
    
    <view class="track-list">
      <view class="track-item" wx:for="{{logisticsData.tracks}}" wx:key="id">
        <view class="track-dot {{index === 0 ? 'active' : ''}}">
          <view class="dot"></view>
          <view class="line" wx:if="{{index < logisticsData.tracks.length - 1}}"></view>
        </view>
        <view class="track-content">
          <text class="track-desc">{{item.description}}</text>
          <text class="track-time">{{item.time}}</text>
          <text class="track-location" wx:if="{{item.location}}">{{item.location}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!logisticsData && !loading && searched}}">
    <image class="empty-icon" src="/images/empty-order.svg" />
    <text class="empty-text">暂无物流信息</text>
    <text class="empty-desc">请检查运单号是否正确或稍后重试</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text>查询中...</text>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="help-section" wx:if="{{!logisticsData && !loading && !searched}}">
    <view class="help-title">
      <text>使用说明</text>
    </view>
    <view class="help-content">
      <text>1. 选择对应的快递公司</text>
      <text>2. 输入完整的运单号</text>
      <text>3. 点击查询按钮获取物流信息</text>
      <text>4. 点击"查看详情"使用快递100官方插件</text>
      <text>5. 支持主流快递公司实时查询</text>
    </view>
  </view>
</view>