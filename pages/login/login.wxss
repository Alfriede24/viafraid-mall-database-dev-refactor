/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 100rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.logo image {
  width: 80rpx;
  height: 80rpx;
}

.app-name {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录表单 */
.login-form {
  width: 100%;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.login-btn::after {
  border: none;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

/* 微信登录按钮 */
.wechat-btn {
  background-color: #07c160;
  color: #fff;
}

.wechat-btn:active {
  background-color: #06ad56;
}

/* 手机号登录按钮 */
.phone-btn {
  background-color: #fff;
  color: #333;
}

.phone-btn:active {
  background-color: #f5f5f5;
}

/* 游客模式按钮 */
.guest-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.guest-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
}

/* 用户信息展示 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 30rpx;
  border: 4rpx solid #fff;
}

.nickname {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-success {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 协议条款 */
.agreement {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 0 20rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.agreement-link {
  font-size: 24rpx;
  color: #fff;
  text-decoration: underline;
  margin: 0 5rpx;
}

/* 底部区域 */
.footer {
  margin-top: auto;
  margin-bottom: 60rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

/* 加载状态 */
.login-btn[disabled] {
  opacity: 0.6;
}

/* 动画效果 */
.login-btn {
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
}

/* 手机号登录弹窗 */
.phone-login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  position: relative;
  z-index: 1001;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  border-radius: 50%;
  background-color: #f5f5f5;
}

.modal-body {
  padding: 40rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #667eea;
}

.code-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 80rpx;
  background-color: #667eea;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn.disabled {
  background-color: #ccc;
  color: #999;
}

.modal-footer {
  padding: 20rpx 40rpx 40rpx;
}

.login-submit-btn {
  width: 100%;
  height: 80rpx;
  background-color: #667eea;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-submit-btn::after {
  border: none;
}

.login-submit-btn.loading {
  background-color: #ccc;
}

.login-submit-btn:active:not([disabled]) {
  background-color: #5a6fd8;
}

/* 响应式适配 */
@media (max-height: 600px) {
  .header {
    margin-top: 60rpx;
    margin-bottom: 60rpx;
  }
  
  .logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 30rpx;
  }
  
  .app-name {
    font-size: 40rpx;
  }
}