/* pages/order/list/list.wxss */
page {
  background-color: #f5f5f5;
}
.container {
  padding-bottom: 40rpx;
}
/* Tab 切换栏 */
.tabs-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  z-index: 100;
}
.tab-item {
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #555;
  position: relative;
  transition: all 0.2s;
}
.tab-item.active {
  color: #111;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #111;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  padding: 110rpx 30rpx 0; /* 留出顶部 Tab 栏空间 */
}
.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-no {
  font-size: 24rpx;
  color: #999;
}
.order-status {
  font-size: 26rpx;
  font-weight: bold;
  color: #111;
}
.card-body {
  padding: 20rpx 0;
}
.product-scroll {
  white-space: nowrap;
}
.product-image-scroll {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
  display: inline-block;
}
.single-product {
  display: flex;
  align-items: center;
}
.product-image-single {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.product-name-single {
  font-size: 28rpx;
  color: #333;
}
.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  padding-top: 20rpx;
}
.item-count {
  color: #999;
}
.total-amount {
  font-weight: bold;
}
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-btn {
  border: 1rpx solid #ccc;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
}
.action-btn.primary {
  background-color: #111;
  color: #fff;
  border-color: #111;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding-top: 300rpx;
  color: #999;
}
.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}
.empty-text {
  font-size: 28rpx;
}
.loading {
  text-align: center;
  padding-top: 300rpx;
  color: #999;
}