/* pages/order/detail/detail.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 订单状态 */
.order-status {
  background-color: #fff;
  padding: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
}

.status-icon image {
  width: 100%;
  height: 100%;
}

.status-info {
  flex: 1;
}

.status-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #999;
}

/* 通用区块样式 */
.address-section,
.logistics-section,
.product-section,
.order-info-section,
.cost-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.section-header .icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
}

.section-header text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.view-more {
  position: absolute;
  right: 30rpx;
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

/* 收货地址 */
.address-info {
  padding: 30rpx;
}

.address-line {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-right: 30rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 物流信息 */
.logistics-info {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.logistics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logistics-row .label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  width: 140rpx;
}

.logistics-row .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.logistics-row .tracking-no {
  color: #007aff;
  text-decoration: underline;
}

.logistics-row .status {
  color: #ff6b35;
  font-weight: 500;
}

.logistics-row .update-time {
  color: #999;
  font-size: 26rpx;
}

/* 兼容旧样式 */
.company {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.tracking-no {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.logistics-info .status {
  font-size: 26rpx;
  color: #ff6b35;
  margin-bottom: 10rpx;
}

.update-time {
  font-size: 24rpx;
  color: #999;
}

/* 商品信息 */
.product-list {
  padding: 0 30rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-specs {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.product-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: bold;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单信息 */
.order-info-list {
  padding: 0 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 26rpx;
  color: #666;
}

.info-item .value {
  font-size: 26rpx;
  color: #333;
}

.value-with-copy {
  display: flex;
  align-items: center;
}

.copy-btn {
  font-size: 24rpx;
  color: #ff6b35;
  margin-left: 20rpx;
  padding: 5rpx 15rpx;
  border: 1rpx solid #ff6b35;
  border-radius: 15rpx;
}

/* 费用明细 */
.cost-list {
  padding: 0 30rpx;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-item .label {
  font-size: 26rpx;
  color: #666;
}

.cost-item .value {
  font-size: 26rpx;
  color: #333;
}

.cost-item .discount {
  color: #ff6b35;
}

.cost-item.total {
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cost-item.total .label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.cost-item.total .value {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

/* 操作按钮 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: flex-end;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
  border: 1rpx solid #ddd;
  min-width: 160rpx;
  text-align: center;
}

.cancel-btn {
  color: #666;
  background-color: #f8f8f8;
  border-color: #ddd;
}

.secondary-btn {
  color: #ff6b35;
  background-color: #fff;
  border-color: #ff6b35;
}

.primary-btn {
  color: #fff;
  background-color: #ff6b35;
  border-color: #ff6b35;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}