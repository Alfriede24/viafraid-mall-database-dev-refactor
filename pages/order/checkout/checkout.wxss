/* pages/order/checkout/checkout.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}
.address-box, .product-list, .summary-box {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.address-info .user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.address {
  font-size: 24rpx;
  color: #999;
}
.product-item {
  display: flex;
  margin-bottom: 20rpx;
}
.product-image {
  width: 150rpx;
  height: 150rpx;
  margin-right: 20rpx;
}
.product-info {
  flex: 1;
}
.summary-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-top: 1rpx solid #eee;
}
.total {
  font-size: 32rpx;
  color: red;
}
.submit-btn {
  background-color: red;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
}