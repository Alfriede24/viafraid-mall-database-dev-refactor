<view class="container">
  <view class="profile-guest" wx:if="{{!hasUserInfo}}">
    <view class="header">
      <view class="login-btn" bindtap="getUserProfile">注册登录</view>
      <view class="header-text">
        <view class="title">成为会员</view>
        <view class="subtitle">解锁更多福利</view>
      </view>
    </view>
    
    <view class="actions-grid">
      <view class="action-item" wx:for="{{mainActions}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
        <image class="action-icon" src="{{item.icon}}"/>
        <text class="action-text">{{item.title}}</text>
      </view>
    </view>
    
    <view class="menu-list">
        <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
            <text>{{item.title}}</text>
            <text class="arrow">></text>
        </view>
    </view>
  </view>

  <block wx:else>
    <view class="user-section">
      <view class="user-info">
        <image class="avatar" src="{{userInfo.avatarUrl}}" />
        <view class="user-details">
          <text class="nickname">{{userInfo.nickName}}</text>
          <text class="desc">会员</text>
        </view>
        <view class="user-actions">
          <view class="edit-btn" bindtap="onEditProfile"><text>编辑</text></view>
          <view class="logout-btn" bindtap="onLogout"><text>退出</text></view>
        </view>
      </view>
    </view>
    <view class="actions-grid logged-in">
       <view class="action-item" wx:for="{{mainActions}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
        <image class="action-icon" src="{{item.icon}}"/>
        <text class="action-text">{{item.title}}</text>
      </view>
    </view>
    <view class="menu-list logged-in">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
        <text>{{item.title}}</text>
        <text class="arrow">></text>
      </view>
    </view>
  </block>
</view>