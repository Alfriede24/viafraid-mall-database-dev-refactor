/* pages/profile/edit/edit.wxss */
page {
  background-color: #f5f5f5;
}
.container {
  padding: 40rpx 30rpx;
  padding-bottom: 200rpx;
}
.header {
  margin-bottom: 40rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #111;
}

/* 头像上传 */
.avatar-uploader {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 60rpx;
}
.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}
.uploader-tip {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  white-space: nowrap;
}
.camera-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

/* 表单 */
.form-group {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child {
  border-bottom: none;
}
.label {
  font-size: 30rpx;
  color: #111;
}
.input, .input-display, .picker-content {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #555;
}

/* 底部按钮 */
.save-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #f5f5f5; /* 与页面背景色一致 */
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.save-btn {
  background-color: #111;
  color: #fff;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}