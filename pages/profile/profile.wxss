/* pages/profile/profile.wxss */
page {
  background-color: #fff;
}
.container {
  background-color: #fff;
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

/* --- 未登录状态 --- */
.profile-guest .header {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}

.profile-guest .login-btn {
  background-color: #111;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 30rpx;
  white-space: nowrap;
}

.profile-guest .header-text .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #111;
  margin-bottom: 8rpx;
}

.profile-guest .header-text .subtitle {
  font-size: 26rpx;
  color: #888;
}

.actions-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
  margin-bottom: 60rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

.menu-list .menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #111;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-list .menu-item:last-child {
  border-bottom: none;
}

.menu-list .arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* --- 已登录状态 --- */
.user-section {
  background-color: #f5f5f5;
  margin: -40rpx -30rpx 0;
  padding: 60rpx 30rpx 40rpx;
}
.user-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
}
.user-details {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}
.desc {
  font-size: 24rpx;
  color: #888;
  display: block;
}

.user-actions {
  display: flex;
  gap: 20rpx;
}
.edit-btn, .logout-btn {
  background-color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid #ddd;
}

.actions-grid.logged-in {
  margin-top: 60rpx;
}

.menu-list.logged-in {
  border-top: 20rpx solid #f5f5f5;
  margin: 0 -30rpx;
  padding: 0 30rpx;
}