/* pages/favorite/favorite.wxss */
page {
  background-color: #f5f5f5;
}
.container {
  padding: 40rpx 30rpx;
}
.header {
  margin-bottom: 20rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #111;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx;
}
.product-card {
  width: calc(50% - 10rpx);
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.product-image {
  width: 100%;
  height: 340rpx;
}
.product-info {
  padding: 20rpx;
}
.product-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  /* 最多显示一行 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #111;
}
.cancel-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cancel-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}
.empty-text {
  font-size: 28rpx;
  margin-bottom: 40rpx;
  display: block;
}
.go-shopping-btn {
  background-color: #111;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: inline-block;
}
.loading {
  text-align: center;
  padding-top: 300rpx;
  color: #999;
}