/* pages/search/search.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索框样式 */
.search-bar {
  background-color: #fff;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  background-color: #07c160;
  color: #fff;
  padding: 15rpx 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* 搜索历史样式 */
.search-history {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  font-size: 26rpx;
  color: #999;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-tag {
  background-color: #f5f5f5;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

/* 热门搜索样式 */
.hot-search {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.hot-header {
  margin-bottom: 30rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-tag {
  background-color: #fff2e8;
  color: #ff6b35;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: 1rpx solid #ff6b35;
}

/* 搜索结果样式 */
.search-results {
  padding: 20rpx;
}

.result-stats {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.product-list {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.product-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price-section {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.current-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b35;
  margin-right: 15rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.product-stats {
  display: flex;
  align-items: center;
}

.sales {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多样式 */
.load-more {
  text-align: center;
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #07c160;
}

/* 加载状态样式 */
.loading {
  text-align: center;
  padding: 60rpx;
  font-size: 28rpx;
  color: #999;
}

/* 空状态样式 */
.empty {
  text-align: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
}