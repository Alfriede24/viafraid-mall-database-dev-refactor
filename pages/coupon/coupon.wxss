/* pages/coupon/coupon.wxss */
page {
  background-color: #f5f5f5;
}
.container {
  padding-bottom: 40rpx;
}
/* Tab 切换栏 */
.tabs-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  z-index: 100;
}
.tab-item {
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #555;
  position: relative;
  transition: all 0.2s;
}
.tab-item.active {
  color: #111;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 6rpx;
  background-color: #111;
  border-radius: 3rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 110rpx 30rpx 0; /* 留出顶部 Tab 栏空间 */
}
.coupon-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  height: 180rpx;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.card-left {
  width: 200rpx;
  background-color: #111;
  color: #fff;
  display: flex;
  align-items: baseline;
  justify-content: center;
  height: 100%;
}

.value-symbol {
  font-size: 32rpx;
  margin-right: 4rpx;
}
.value {
  font-size: 72rpx;
  font-weight: bold;
}

.card-main {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}
.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.coupon-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0;
}
.valid-period {
  font-size: 22rpx;
  color: #aaa;
  margin-top: auto;
}

.card-right {
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.use-btn {
  background-color: #111;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
}

.status-stamp {
  width: 100rpx;
  height: 100rpx;
  opacity: 0.5;
}

/* 已失效/已使用状态 */
.coupon-card.disabled .card-left {
  background-color: #ccc;
}
.coupon-card.disabled .card-main .coupon-name,
.coupon-card.disabled .card-main .coupon-desc,
.coupon-card.disabled .card-main .valid-period {
  color: #bbb;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding-top: 300rpx;
  color: #999;
}
.empty-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 28rpx;
  margin-bottom: 40rpx;
  display: block;
}
.get-coupon-btn {
  border: 1rpx solid #111;
  color: #111;
  padding: 15rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.loading {
  text-align: center;
  padding-top: 300rpx;
  color: #999;
}