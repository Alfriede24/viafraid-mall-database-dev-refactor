/* 领取优惠券页面样式 */
.get-coupon-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 页面头部样式 */
.page-header {
  background: linear-gradient(135deg, #ff6b35, #ff8f65);
  padding: 40rpx 30rpx 60rpx;
  color: #fff;
}

.header-content {
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 优惠券列表样式 */
.coupon-list {
  height: calc(100vh - 240rpx);
  padding: 20rpx;
}

.coupon-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.coupon-main {
  display: flex;
  position: relative;
}

/* 优惠券左侧样式 */
.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8f65);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fff;
  padding: 40rpx 0;
}

.coupon-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.amount-symbol {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.amount-value {
  font-size: 48rpx;
  font-weight: bold;
}

.discount-value {
  font-size: 48rpx;
  font-weight: bold;
}

.discount-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}

.free-shipping {
  font-size: 32rpx;
  font-weight: bold;
}

.coupon-condition {
  font-size: 20rpx;
  opacity: 0.9;
  text-align: center;
}

/* 优惠券右侧样式 */
.coupon-right {
  flex: 1;
  padding: 30rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-info {
  flex: 1;
}

.coupon-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.coupon-stock {
  font-size: 22rpx;
  color: #ff6b35;
}

/* 领取按钮样式 */
.coupon-action {
  margin-left: 20rpx;
}

.receive-btn {
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.receive-btn[data-loading="true"] {
  background-color: #ffb399;
}

.received-btn {
  background-color: #f5f5f5;
  color: #999;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

.sold-out-btn {
  background-color: #f5f5f5;
  color: #999;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

/* 进度条样式 */
.progress-container {
  padding: 20rpx 30rpx;
  border-top: 1px solid #f0f0f0;
}

.progress-bar {
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b35, #ff8f65);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* 优惠券装饰 */
.coupon-decoration {
  position: absolute;
  left: 200rpx;
  top: 0;
  bottom: 0;
  width: 0;
}

.decoration-circle {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
  left: -12rpx;
}

.decoration-top {
  top: -12rpx;
}

.decoration-bottom {
  bottom: -12rpx;
}

/* 空状态样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* 底部操作栏样式 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1px solid #eee;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.bottom-info {
  flex: 1;
}

.info-text {
  font-size: 24rpx;
  color: #666;
}

.my-coupons-btn {
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 成功提示弹窗样式 */
.success-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.success-modal {
  width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  margin: 40rpx;
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
  background-color: #52c41a;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  color: #fff;
  margin: 0 auto 30rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.success-content {
  margin-bottom: 40rpx;
}

.success-coupon {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.success-coupon-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.success-coupon-desc {
  font-size: 24rpx;
  color: #666;
}

.success-actions {
  display: flex;
  gap: 20rpx;
}

.continue-btn {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.use-now-btn {
  flex: 1;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}