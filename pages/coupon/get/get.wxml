<view class="get-coupon-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-content">
      <text class="header-title">领取优惠券</text>
      <text class="header-subtitle">精选优惠，限时领取</text>
    </view>
  </view>

  <!-- 优惠券列表 -->
  <scroll-view 
    class="coupon-list" 
    scroll-y="true" 
    bindscrolltolower="loadMore"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view wx:if="{{loading && coupons.length === 0}}" class="loading-container">
      <view class="loading-text">加载中...</view>
    </view>

    <view wx:elif="{{coupons.length === 0}}" class="empty-container">
      <image src="/images/empty-coupon.svg" class="empty-image" mode="aspectFit"></image>
      <text class="empty-text">暂无可领取的优惠券</text>
      <text class="empty-subtitle">请稍后再来看看吧</text>
    </view>

    <view wx:else>
      <view 
        wx:for="{{coupons}}" 
        wx:key="id" 
        class="coupon-card"
      >
        <!-- 优惠券主体 -->
        <view class="coupon-main">
          <!-- 左侧优惠信息 -->
          <view class="coupon-left">
            <view class="coupon-amount">
              <text wx:if="{{item.type === 'FullReduction'}}" class="amount-symbol">¥</text>
              <text wx:if="{{item.type === 'FullReduction'}}" class="amount-value">{{item.discountAmount}}</text>
              <text wx:elif="{{item.type === 'Discount'}}" class="discount-value">{{item.discountPercentage}}</text>
              <text wx:elif="{{item.type === 'Discount'}}" class="discount-unit">折</text>
              <text wx:elif="{{item.type === 'FreeShipping'}}" class="free-shipping">免邮</text>
            </view>
            <view class="coupon-condition">
              <text wx:if="{{item.minAmount > 0}}">满{{item.minAmount}}可用</text>
              <text wx:else>无门槛</text>
            </view>
          </view>

          <!-- 右侧优惠券信息 -->
          <view class="coupon-right">
            <view class="coupon-info">
              <view class="coupon-name">{{item.name}}</view>
              <view class="coupon-desc">{{item.description}}</view>
              <view class="coupon-time">
                <text>{{item.startTime}} 至 {{item.endTime}}</text>
              </view>
              <view class="coupon-stock">
                <text>剩余：{{item.remainingQuantity}}/{{item.totalQuantity}}</text>
              </view>
            </view>
            
            <!-- 领取按钮 -->
            <view class="coupon-action">
              <button 
                wx:if="{{item.remainingQuantity > 0 && !item.isReceived}}"
                class="receive-btn" 
                bindtap="receiveCoupon" 
                data-coupon="{{item}}"
                data-loading="{{item.receiving}}"
              >
                <text wx:if="{{item.receiving}}">领取中...</text>
                <text wx:else>立即领取</text>
              </button>
              <button wx:elif="{{item.isReceived}}" class="received-btn" disabled>
                已领取
              </button>
              <button wx:else class="sold-out-btn" disabled>
                已抢完
              </button>
            </view>
          </view>
        </view>

        <!-- 进度条 -->
        <view class="progress-container">
          <view class="progress-bar">
            <view 
              class="progress-fill" 
              style="width: {{(item.totalQuantity - item.remainingQuantity) / item.totalQuantity * 100}}%"
            ></view>
          </view>
          <view class="progress-text">
            <text>已领取 {{item.totalQuantity - item.remainingQuantity}} 张</text>
          </view>
        </view>

        <!-- 优惠券装饰 -->
        <view class="coupon-decoration">
          <view class="decoration-circle decoration-top"></view>
          <view class="decoration-circle decoration-bottom"></view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{hasMore}}" class="load-more">
        <view wx:if="{{loadingMore}}" class="loading-text">加载中...</view>
        <view wx:else class="load-more-text">上拉加载更多</view>
      </view>
      <view wx:elif="{{coupons.length > 0}}" class="no-more">
        <text>没有更多了</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-info">
      <text class="info-text">已领取 {{receivedCount}} 张优惠券</text>
    </view>
    <button class="my-coupons-btn" bindtap="goToMyCoupons">
      我的优惠券
    </button>
  </view>
</view>

<!-- 领取成功提示 -->
<view wx:if="{{showSuccessModal}}" class="success-modal-mask">
  <view class="success-modal">
    <view class="success-icon">✓</view>
    <view class="success-title">领取成功！</view>
    <view class="success-content">
      <view class="success-coupon">
        <text class="success-coupon-name">{{successCoupon.name}}</text>
        <text class="success-coupon-desc">{{successCoupon.description}}</text>
      </view>
    </view>
    <view class="success-actions">
      <button class="continue-btn" bindtap="closeSuccessModal">继续领取</button>
      <button class="use-now-btn" bindtap="goToMyCoupons">立即使用</button>
    </view>
  </view>
</view>