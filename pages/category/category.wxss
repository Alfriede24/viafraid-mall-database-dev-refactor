page {
  height: 100%;
  overflow: hidden;
}

.page-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 1. 顶部大类导航 */
.main-category-tabs {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.tab-item {
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #000;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #000;
  border-radius: 3rpx;
}

/* 2. 主体内容区 */
.content-wrapper {
  display: flex;
  flex: 1;
  overflow: hidden;
}
.left-sidebar {
  width: 200rpx;
  background-color: #f8f8f8;
  height: 100%;
}
.sidebar-item {
  padding: 30rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #555;
  position: relative;
}
.sidebar-item.active {
  background-color: #fff;
  color: #000;
  font-weight: 500;
}
.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 40rpx;
  background-color: #e25041;
}

/* 右侧内容展示 */
.right-content {
  flex: 1;
  background-color: #fff;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* --- 通用選擇格樣式 (熱銷和品牌共用) --- */
.selection-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.selection-item {
  width: 32%;
  margin-bottom: 24rpx;
  text-align: center;
}
.selection-image {
  width: 100%;
  height: 120rpx; /* 橫向長方形 */
  border-radius: 12rpx;
  background-color: #f4f4f4;
}
.selection-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 10rpx;
}

/* 通用小標題樣式 */
.subtitle-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.back-button {
  font-size: 28rpx;
  color: #000000;
  font-weight: normal;
  margin-right: 20rpx;
}
.subtitle-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 商品網格樣式 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-item {
  width: 49%;
  margin-bottom: 20rpx;
}
.product-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background-color: #f4f4f4;
}
.product-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-price {
  font-size: 28rpx;
  color: #e25041;
  font-weight: bold;
  margin-top: 10rpx;
}
.product-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}
.meta-item {
  display: inline-flex;
  align-items: center;
}
.empty-state {
  width: 100%;
  text-align: center;
  color: #999;
  padding: 100rpx 0;
}