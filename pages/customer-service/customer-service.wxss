/* pages/customer-service/customer-service.wxss */
page {
  background-color: #f5f5f5;
}
.container {
  padding: 40rpx 30rpx;
  padding-bottom: 200rpx; /* 为底部按钮留出空间 */
}
.header {
  margin-bottom: 40rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #111;
}

/* 常见问题 */
.faq-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}
.faq-header {
  font-size: 32rpx;
  font-weight: bold;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.faq-item {
  border-bottom: 1rpx solid #f0f0f0;
}
.faq-item:last-child {
  border-bottom: none;
}
.question-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
}
.question-text {
  font-size: 28rpx;
  color: #333;
}
.arrow {
  font-size: 28rpx;
  color: #ccc;
  transition: transform 0.3s ease;
}
.arrow.expanded {
  transform: rotate(90deg);
}

.answer-row {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}
.answer-row.show {
  max-height: 500rpx; /* 一个足够大的值 */
  padding-bottom: 30rpx;
}
.answer-text {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

/* 底部按钮 */
.contact-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}
.contact-btn {
  background-color: #111;
  color: #fff;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}
.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
