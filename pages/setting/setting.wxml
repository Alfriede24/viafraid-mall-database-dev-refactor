<view class="container">
  <view class="header">
    <text class="title">设置</text>
  </view>

  <view class="setting-group">
    <view class="setting-item">
      <view class="item-content">
        <text class="label">消息通知</text>
        <text class="desc">接收订单状态和优惠活动通知</text>
      </view>
      <switch checked="{{notifications}}" bindchange="onNotificationChange" color="#111"/>
    </view>
    <view class="setting-item" bindtap="clearCache">
      <view class="item-content">
        <text class="label">清除缓存</text>
        <text class="desc">清除本地图片及数据缓存</text>
      </view>
      <view class="item-action">
        <text class="cache-size">{{cacheSize}}</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>

  <view class="setting-group">
    <view class="setting-item" bindtap="onAboutUs">
      <view class="item-content">
        <text class="label">关于我们</text>
      </view>
      <view class="item-action">
        <text class="arrow">></text>
      </view>
    </view>
    <view class="setting-item">
      <view class="item-content">
        <text class="label">当前版本</text>
      </view>
      <view class="item-action">
        <text class="version">v1.0.0</text>
      </view>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>
</view>